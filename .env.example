# Razorpay AI Buildathon — Track 01 Environment Configuration

# Gemini API Key (Get from Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Test API Credentials (Get from Razorpay Dashboard in Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Database URL
DATABASE_URL=sqlite:///./agentic_commerce.db

# Default Guardrail Spending Cap (in INR)
SPENDING_CAP_INR=2000.0

# Gating Mode ('CLI' for human-in-the-loop terminal review or 'AUTO_APPROVE')
GATING_MODE=CLI
